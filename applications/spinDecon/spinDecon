from __future__ import annotations

import os
import sys
from pathlib import Path


def _bootstrap_source_tree() -> Path:
    """Use the suite venv and make application packages + native bin discoverable."""
    launcher_dir = Path(__file__).resolve().parent
    archive_dir = launcher_dir.parent
    root = archive_dir.parent
    venv_python = root / ".venv" / "bin" / "python"
    if venv_python.is_file() and Path(sys.executable).resolve() != venv_python.resolve():
        os.execv(str(venv_python), [str(venv_python), str(Path(__file__).resolve()), *sys.argv[1:]])
    archive_text = str(archive_dir)
    if archive_text not in sys.path:
        sys.path.insert(0, archive_text)
    bin_dir = root / "bin"
    if bin_dir.is_dir():
        os.environ["PATH"] = str(bin_dir) + os.pathsep + os.environ.get("PATH", "")
    return root


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) > 1:
        raise SystemExit("usage: spinDecon [project-parameter-file]")

    _bootstrap_source_tree()

    # wx is intentionally the only substantial GUI import before the working
    # directory chooser.  In particular, defer matplotlib/scipy/notebook
    # imports until after the user has chosen a directory.  This makes a cold
    # application launch responsive even when Python is filling caches.
    import wx

    from spinDecon.project.service import ProjectService, DEFAULT_PARAMETER_NAME

    service = ProjectService()
    explicit = bool(argv)
    if explicit:
        parameter_file = Path(argv[0]).expanduser().resolve(strict=False)
    else:
        from spinDecon.gui.dialogs.working_directory import choose_working_directory

        startup_app = wx.App()
        working_dir = choose_working_directory(None, initial_directory=Path.cwd())
        if working_dir is None:
            return 0
        os.chdir(working_dir)
        parameter_file = service.discover_parameter_file(working_dir)

    # Heavy GUI/scientific imports happen only after startup interaction.
    import matplotlib
    matplotlib.use("WXAgg")
    from spinDecon.app.notebook import MyApp

    print("----------------------------------------------")
    print("  Running spinDecon GUI")
    print("----------------------------------------------")
    print("  post-refactor architecture - 24th August 2026")
    print("  (c) University of Oxford")
    print("----------------------------------------------")

    # Reuse the wx.App created for the startup chooser.  Explicit project-file
    # launches (e.g. developer/SpinHub integration) do not need the chooser.
    app = wx.GetApp() or wx.App()
    if parameter_file is None or not parameter_file.is_file():
        from spinDecon.gui.dialogs.project_setup import run_project_setup

        target_name = parameter_file.name if explicit else DEFAULT_PARAMETER_NAME
        state = run_project_setup(
            None,
            service=service,
            directory=Path.cwd(),
            parameter_name=target_name,
        )
        if state is None:
            return 0
        parameter_file = Path(state.parameter_file).resolve(strict=False)
    else:
        state = service.prepare_open(parameter_file, change_cwd=True)
        parameter_file = Path(state.parameter_file).resolve(strict=False)
        # An interactive application launch makes the user's selected folder
        # the process working directory. Explicit developer/project launches
        # retain ProjectService's canonical project-directory behaviour.
        if not explicit:
            os.chdir(working_dir)

    # Retain this environment variable only as an external-tool compatibility
    # boundary. The canonical application state is ProjectState.
    os.environ["SPINDECON_PARAMETER_FILE"] = str(parameter_file)
    os.environ["SPINDECON_WORKING_DIRECTORY"] = str(Path.cwd())

    MyApp(str(parameter_file), state=state)
    app.MainLoop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
